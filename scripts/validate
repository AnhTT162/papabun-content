#!/usr/bin/env python3
"""Kiểm tra toàn bộ nội dung. Dùng: scripts/validate"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from papabun.content import Repo  # noqa: E402

repo = Repo(Path(__file__).resolve().parent.parent)
errors = repo.validate()
for error in errors:
    print("✗ " + error)
if errors:
    print("\n%d lỗi." % len(errors))
    sys.exit(1)
print("✓ Hợp lệ: %d track, %d topic, %d thuật ngữ, %d công nghệ." % (
    len(repo.tracks["tracks"]), len(repo.topics), len(repo.glossary["terms"]),
    len(repo.project_questions["technologies"]),
))
