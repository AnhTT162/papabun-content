      "y": 0.05
    },
    {
      "id": "q-email",
      "label": "SQS email",
      "kind": "queue",
      "x": 0.1,
      "y": 0.5
    },
    {
      "id": "q-stock",
      "label": "SQS kho",
      "kind": "queue",
      "x": 0.85,
      "y": 0.5
    },
    {
      "id": "dlq",
      "label": "DLQ kho",
      "kind": "queue",
      "x": 0.1,
      "y": 0.95
    },
    {
