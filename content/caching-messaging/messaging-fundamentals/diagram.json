  "edges": [
    {
      "id": "order-topic",
      "from": "order",
      "to": "topic",
      "label": "publish OrderPlaced"
    },
    {
      "id": "topic-email",
      "from": "topic",
      "to": "q-email",
      "label": "bản sao 1"
    },
    {
      "id": "topic-stock",
      "from": "topic",
      "to": "q-stock",
      "label": "bản sao 2"
    },
    {
      "id": "stock-worker",
