  "steps": [
    {
      "caption": "Producer băm key để chọn partition, rồi gửi lô message tới broker đang là leader của partition đó.",
      "show": [
        "producer",
        "leader",
        "producer-leader"
      ],
      "highlight": [
        "producer-leader"
      ]
    },
    {
      "caption": "Các follower liên tục kéo dữ liệu mới từ leader. Follower theo kịp nằm trong ISR; tụt quá replica.lag.time.max.ms thì bị loại.",
      "show": [
        "f1",
        "f2",
        "f1-leader",
        "f2-leader"
      ],
      "highlight": [
        "f1-leader",
        "f2-leader"
      ]
    },
    {
      "caption": "Khi mọi replica trong ISR đã có message, high watermark tiến lên và leader xác nhận với producer (acks=all). Với min.insync.replicas=2, ISR còn dưới 2 thì ghi bị từ chối.",
      "show": [],
      "highlight": [
        "leader",
        "producer-leader"
      ]
    },
    {
      "caption": "Consumer đọc từ leader nhưng chỉ tới high watermark, nên không thấy message có thể bị mất khi đổi leader (khi unclean election tắt).",
      "show": [
        "consumer",
        "consumer-leader"
      ],
      "highlight": [
        "consumer-leader"
      ]
    },
    {
      "caption": "Broker 1 chết: controller chọn một replica trong ISR làm leader mới. Producer và consumer cập nhật metadata rồi nói chuyện với Broker 2.",
      "show": [
        "controller",
        "controller-f1"
      ],
      "highlight": [
        "controller-f1"
      ]
    }
  ]
