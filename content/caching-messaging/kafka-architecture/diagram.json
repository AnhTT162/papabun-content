    {
      "id": "f1-leader",
      "from": "f1",
      "to": "leader",
      "label": "kéo dữ liệu"
    },
    {
      "id": "f2-leader",
      "from": "f2",
      "to": "leader",
      "label": "kéo dữ liệu"
    },
    {
      "id": "consumer-leader",
