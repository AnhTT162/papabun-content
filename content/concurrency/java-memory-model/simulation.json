{
  "$schema": "../../../schema/blocks/simulation.schema.json",
  "engine": "threadTimeline",
  "title": "Công bố data qua cờ volatile",
  "instructions": "`data` là biến thường, `ready` là `volatile`. Chạy lịch \"Reader chờ trước\" và xem cache của Reader: lần đọc `data` đầu tiên đưa `0` vào cache, nhưng mỗi lần đọc `ready` (volatile) bỏ giá trị cũ đó đi, nên sau khi thấy `ready == true`, Reader đọc lại `data` và thấy `42`. Lần ghi volatile đẩy theo mọi thứ Writer ghi trước nó.",
  "config": {
    "memoryModel": "jmm",
    "resources": [
      {
        "id": "data",
        "kind": "variable",
        "label": "data",
        "valueType": "int",
        "initial": 0,
        "volatile": false
      },
      {
        "id": "ready",
        "kind": "variable",
        "label": "ready",
        "valueType": "boolean",
        "initial": 0,
        "volatile": true
      },
      {
        "id": "result",
        "kind": "variable",
        "label": "result",
        "valueType": "int",
        "initial": -1,
        "volatile": true
      }
    ],
    "threads": [
      {
        "id": "writer",
        "name": "Writer",
        "steps": [
          {
            "op": "write",
            "target": "data",
            "value": 42,
            "code": "data = 42;"
          },
          {
            "op": "write",
            "target": "ready",
            "value": 1,
            "code": "ready = true;   // volatile"
          }
        ]
      },
      {
        "id": "reader",
        "name": "Reader",
        "steps": [
          {
            "op": "read",
            "target": "data",
            "into": "before",
            "code": "int before = data;"
          },
          {
            "op": "spinUntil",
            "target": "ready",
            "value": 1,
            "code": "while (!ready) { }"
          },
          {
            "op": "read",
            "target": "data",
            "into": "seen",
            "code": "int seen = data;"
          },
          {
            "op": "write",
            "target": "result",
            "from": "seen",
            "code": "result = seen;"
          }
        ]
      }
    ],
    "schedules": [
      {
        "id": "writer-first",
        "title": "Writer ghi xong trước",
        "order": [
          "writer",
          "writer",
          "reader",
          "reader",
          "reader",
          "reader"
        ]
      },
      {
        "id": "reader-first",
        "title": "Reader chờ trước",
        "order": [
          "reader",
          "reader",
          "writer",
          "writer",
          "reader",
          "reader",
          "reader"
        ]
      }
    ],
    "expect": [
      {
        "target": "result",
        "value": 42
      }
    ],
    "outcomes": {
      "success": "Ghi `data` happens-before ghi `ready` (program order), ghi `ready` happens-before lần đọc thấy `true` (volatile), lần đọc đó happens-before đọc `data` (program order). Bắc cầu: Reader chắc chắn thấy `42`, dù `data` không volatile.",
      "mismatch": "Reader thấy giá trị cũ của `data`: không có chuỗi happens-before nào nối lần ghi với lần đọc."
    }
  }
}