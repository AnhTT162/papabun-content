  "steps": [
    { "caption": "supplyAsync nộp hai lời gọi độc lập vào executor riêng. Chúng chạy song song, thread của request không bị chặn.", "show": ["user", "orders"] },
    { "caption": "thenCombine chờ cả hai xong rồi gộp thành Profile. Một bên lỗi thì stage gộp cũng lỗi.", "show": ["combine", "user-combine", "orders-combine"], "highlight": ["user-combine", "orders-combine"] },
    { "caption": "thenCompose dùng khi bước sau tự trả về CompletableFuture (gọi service gợi ý). Dùng thenApply sẽ ra future lồng future.", "show": ["reco", "combine-reco"], "highlight": ["combine-reco"] },
    { "caption": "orTimeout(800ms) đặt hạn cho cả chuỗi. Mọi bước thành công thì kết quả đi thẳng tới response.", "show": ["response", "reco-response"], "highlight": ["reco-response"] },
    { "caption": "Lỗi ở bất kỳ stage nào phía trên (bọc trong CompletionException) hoặc hết giờ đều rơi vào exceptionally.", "show": ["fallback", "reco-fallback"], "highlight": ["reco-fallback"] },
    { "caption": "exceptionally trả hồ sơ không có phần gợi ý, nên trang vẫn hiển thị thay vì lỗi 500.", "show": ["fallback-response"], "highlight": ["fallback-response"] }
  ]
