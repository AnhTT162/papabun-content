  "edges": [
    { "id": "query-root", "from": "query", "to": "root", "label": "bắt đầu từ gốc" },
    { "id": "root-branch", "from": "root", "to": "branch", "label": "42 < 5000" },
    { "id": "branch-leaf", "from": "branch", "to": "leaf", "label": "40 ≤ 42 < 80" },
    { "id": "leaf-heap", "from": "leaf", "to": "heap", "label": "đọc dòng theo TID" },
