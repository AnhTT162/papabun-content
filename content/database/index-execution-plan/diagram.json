    { "id": "branch", "label": "Branch page", "kind": "database", "x": 0.85, "y": 0.5 },
    { "id": "leaf", "label": "Leaf: 42 → TID", "kind": "database", "x": 0.85, "y": 0.95 },
    { "id": "heap", "label": "Dòng trong bảng", "kind": "generic", "x": 0.1, "y": 0.95 },
