        "app-to-db"
      ],
      "highlight": [
        "app-to-db"
      ]
    },
    {
      "caption": "Response đi ngược lại qua load balancer về trình duyệt.",
      "show": [
        "response"
      ],
      "highlight": [
        "response"
      ]
    },
    {
      "caption": "Request tiếp theo dùng lại kết nối keep-alive: bỏ qua DNS, TCP và TLS, gửi thẳng HTTP.",
