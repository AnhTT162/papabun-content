{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blocks/diagram.schema.json",
  "title": "Block diagram: sơ đồ hiện dần. Toạ độ x, y trong khoảng 0–1.",
  "type": "object",
  "required": ["title", "nodes", "edges", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "$ref": "../common.schema.json#/$defs/text" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "x", "y"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "../common.schema.json#/$defs/id" },
          "label": { "$ref": "../common.schema.json#/$defs/text" },
          "kind": { "enum": ["client", "service", "database", "cache", "queue", "external", "generic"] },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "../common.schema.json#/$defs/id" },
          "from": { "$ref": "../common.schema.json#/$defs/id" },
          "to": { "$ref": "../common.schema.json#/$defs/id" },
          "label": { "$ref": "../common.schema.json#/$defs/text" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["caption", "show"],
        "additionalProperties": false,
        "properties": {
          "caption": { "$ref": "../common.schema.json#/$defs/text" },
          "show": { "type": "array", "items": { "$ref": "../common.schema.json#/$defs/id" }, "description": "id node/edge hiện thêm ở bước này" },
          "highlight": { "type": "array", "items": { "$ref": "../common.schema.json#/$defs/id" } }
        }
      }
    }
  }
}
